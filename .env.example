# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 커밋되지 않습니다.

# console.ncloud.com에서 Maps > Geocoding 상품으로 발급받은 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 앱 로그인 비밀번호 (직접 정하는 값, 회원가입 없음)
AUTH_PASSWORD=

# JWT 서명 키 (임의의 긴 무작위 문자열로 설정)
JWT_SECRET=

# --- GitHub Codespaces에서 실행할 때만 채우기 (로컬 Docker면 비워두면 됨) ---
# 터미널에서 `echo $CODESPACE_NAME` 으로 확인한 값을 아래 형식에 넣기
# 예: CODESPACE_NAME이 verbose-space-xxxxx 라면
#   VITE_API_BASE_URL=https://verbose-space-xxxxx-8000.app.github.dev
#   CORS_ORIGINS=https://verbose-space-xxxxx-5173.app.github.dev
VITE_API_BASE_URL=
CORS_ORIGINS=
