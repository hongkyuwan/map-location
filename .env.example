# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 커밋되지 않습니다.

# console.ncloud.com에서 Maps > Geocoding 상품으로 발급받은 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 앱 로그인 비밀번호 (직접 정하는 값, 회원가입 없음)
AUTH_PASSWORD=

# JWT 서명 키 (임의의 긴 무작위 문자열로 설정)
JWT_SECRET=

# 아래 두 값은 보통 비워두면 됨 (로컬/Codespaces 모두 프론트엔드가 자기 포트로 들어오는
# /api 요청을 내부적으로 backend 컨테이너에 전달하므로 브라우저가 8000 포트에 직접 접속할 필요가 없음)
VITE_API_BASE_URL=
CORS_ORIGINS=
